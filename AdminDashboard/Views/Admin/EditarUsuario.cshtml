@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar Usuario";
}

@using AdminDashboard.Models.DTO
@model EditarUsuarioDto

<div class="page-header">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
        <a href="/Admin/Usuarios"
               style="width:32px;height:32px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);text-decoration:none;font-size:14px;transition:all .15s;"
               onmouseover="this.style.borderColor='var(--indigo)';this.style.color='var(--indigo)'"
               onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 style="margin:0;">Editar Usuario</h1>
    </div>
    <p>Modifica los datos del usuario seleccionado.</p>
</div>

<div style="max-width:560px;">
    <div class="card-panel">
        <div class="card-panel-header">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:42px;height:42px;background:var(--indigo-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:var(--indigo);border:1.5px solid var(--border);">
                    @(Model.Nombre?.Length > 0
                        ? Model.Nombre[0].ToString().ToUpper()
                        : "?")
                </div>
                <div>
                    <h5 style="margin:0;">@Model.Nombre @Model.ApePat</h5>
                    <div class="subtitle">ID #@Model.IdUsuario</div>
                </div>
            </div>
            <span class="pill-badge indigo">Editando</span>
        </div>

        <div class="card-panel-body">
            <form method="post" action="/Admin/EditarUsuario">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-modern">Nombre</label>
                        <input name="Nombre" type="text" required
                               value="@Model.Nombre"
                               class="form-control-modern" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-modern">Apellido Paterno</label>
                        <input name="ApePat" type="text" required
                               value="@Model.ApePat"
                               class="form-control-modern" />
                    </div>

                    <div class="col-12">
                        <label class="form-label-modern">Apellido Materno</label>
                        <input name="ApeMate" type="text" required
                               value="@Model.ApeMate"
                               class="form-control-modern" />
                    </div>

                    <div class="col-12">
                        <label class="form-label-modern">Número de teléfono</label>
                        <input name="NroTelefono" type="tel" required
                               value="@Model.NroTelefono"
                               class="form-control-modern" />
                    </div>
                </div>

                <div style="display:flex; gap:10px; margin-top:24px; padding-top:20px; border-top:1px solid var(--border);">
                    <button type="submit" class="btn-primary-modern" style="display:flex; align-items:center; gap:8px;">
                        <i class="bi bi-check-lg"></i> Guardar cambios
                    </button>
                    <a href="/Admin/Usuarios"
                           style="padding:10px 18px; border-radius:10px; border:1.5px solid var(--border); color:var(--text-2); text-decoration:none; font-size:14px; font-weight:500; transition:all .15s;"
                           onmouseover="this.style.borderColor='var(--indigo)';this.style.color='var(--indigo)'"
                           onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-2)'">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
